{
    "version": 4,
    "vendor": {
        "conan": {}
    },
    "include": [
        "build/Debug/generators/CMakePresets.json",
        "build/Release/generators/CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "conan-debug-no-copy",
            "displayName": "conan-debug (no source copy)",
            "inherits": "conan-debug",
            "vendor": {
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "forceWSL1Toolset": true,
                    "copySources": false
                }
            }
        },
        {
            "name": "conan-release-no-cop",
            "displayName": "conan-release (no source copy)",
            "inherits": "conan-release",
            "vendor": {
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "forceWSL1Toolset": true,
                    "copySources": false
                }
            }
        }
    ]
}